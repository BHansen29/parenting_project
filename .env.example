PORT=3000
NODE_ENV=development

# MongoDB (use 127.0.0.1 to avoid localhost DNS/IPv6 issues on some machines)
MONGODB_URI=mongodb://admin:password123@127.0.0.1:27017/parenting_db?authSource=admin&directConnection=true

# Session / app secret
SESSION_SECRET=replace-with-a-long-random-secret

# Firebase Admin
FIREBASE_SERVICE_ACCOUNT_PATH=./backend/firebase-service-account.json

# Firebase Web Config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Frontend -> Backend API base URL
VITE_API_BASE_URL=http://127.0.0.1:3000
