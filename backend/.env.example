# Copy this file to .env and fill in your values
# cp .env.example .env

PORT=3000
NODE_ENV=development

# MongoDB connection string (matches docker-compose.yml credentials)
MONGODB_URI=mongodb://admin:password123@localhost:27017/parenting_db?authSource=admin

# Session signing secret used by express-session (server secret)
SESSION_SECRET=replace-with-a-long-random-secret

# Firebase Web App config
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Firebase Admin credentials
# 1) Path to local service account key file
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# 2) JSON contents of service account key
# FIREBASE_SERVICE_ACCOUNT_JSON=
